<h1>Tic-Tac-Toe</h1>

<% if flash[:alert] %>
  <p class="error"><%= flash[:alert] %></p>
<% end %>

<%= render "games/board", board: board, game: game %>

<% if board.winner %>
  <p><%= board.winner %> wins!</p>
<% elsif board.draw? %>
  <p>Draw!</p>
<% else %>
  <p><%= board.next_turn %> to move</p>
<% end %>

<% if board.over? %>
  <%= button_to "New Game", games_path, method: :post %>
<% end %>
